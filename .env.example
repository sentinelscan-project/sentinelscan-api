# ---------------------------------------------------------------------------
# Core service
# ---------------------------------------------------------------------------
# NOTE: every placeholder value below (this DATABASE_URL host, the JWT_SECRET
# below, etc.) is rejected at startup when NODE_ENV=production — see
# src/config.ts and the README's "Production Deployment" section. That check
# only runs in production, so copying this file as-is is fine for local work.
PORT=4000
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/sentinelscan?sslmode=require

# ---------------------------------------------------------------------------
# Authentication (Stage 1)
# ---------------------------------------------------------------------------
# Signing key for session JSON Web Tokens. Minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-value-at-least-32-chars
# Session lifetime, in any format accepted by jsonwebtoken (e.g. 15m, 12h, 7d).
JWT_EXPIRES_IN=1d
# Name of the HttpOnly cookie carrying the session token.
AUTH_COOKIE_NAME=sentinelscan_token
# Browser origin of the SentinelScan web app. Used as the CORS allowlist and as
# the post-Google-sign-in redirect target.
WEB_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OIDC (optional)
# ---------------------------------------------------------------------------
# Leave all three unset to run without Google sign-in: /auth/google and
# /auth/google/callback then respond 503 GOOGLE_OAUTH_NOT_CONFIGURED.
# Obtain credentials from https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application") and register the callback URL below
# as an authorized redirect URI. Never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---------------------------------------------------------------------------
# Email Service / Verification (Stage 1)
# ---------------------------------------------------------------------------
# Email provider: "development" (default: outputs verification URLs to server logs)
# or "resend" (production transactional email via Resend API).
EMAIL_PROVIDER=development
EMAIL_FROM=SentinelScan <noreply@sentinelscan.io>
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=
# Generic alias:
# EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# OWASP ZAP integration (Stage 4)
# ---------------------------------------------------------------------------
# Base URL of the ZAP daemon's JSON API. In Docker Compose this is the
# internal service name (see docker-compose.yml); for local development
# without Docker, run ZAP yourself and point this at it, e.g.:
#   docker run -p 8090:8090 ghcr.io/zaproxy/zaproxy:stable \
#     zap.sh -daemon -host 0.0.0.0 -port 8090 -config api.disablekey=true
ZAP_BASE_URL=http://localhost:8090
# Only needed if the ZAP daemon has API-key auth enabled (the Docker Compose
# setup disables it via api.disablekey=true). Never sent to the browser.
# ZAP_API_KEY=
# Timeouts — all in milliseconds, all optional (defaults shown).
# ZAP_HTTP_TIMEOUT_MS=10000
# ZAP_CRAWL_TIMEOUT_MS=300000
# ZAP_ACTIVE_SCAN_TIMEOUT_MS=1800000
# ZAP_OVERALL_SCAN_TIMEOUT_MS=2400000
# ZAP_POLL_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# AI Security Analyst (Stage 6 & 7: Google Gemini)
# ---------------------------------------------------------------------------
# AI provider: "gemini"
AI_PROVIDER=gemini
# Which Gemini model performs security analysis.
AI_MODEL=gemini-2.5-flash
# Google Gemini API key. Optional: the API boots and every other feature
# works without it, but POST /scans/:scanId/analyze will accept the request
# and then finish the analysis "failed" with a safe error message, since the
# AI provider call itself cannot succeed without a key. Never sent to the browser,
# never logged. Get one at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# Per-analysis timeout for the AI provider call itself, and a ceiling on its
# output size (ms / tokens).
# ANALYSIS_TIMEOUT_MS=120000
# ANALYSIS_MAX_OUTPUT_TOKENS=8000


