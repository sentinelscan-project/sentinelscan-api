datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Application user.
///
/// A user authenticates either with a local email/password credential
/// (`passwordHash`) or through Google OAuth/OIDC (`googleId`), or both once a
/// local account has been linked to a Google identity. Google-only users
/// therefore have a null `passwordHash`.
///
/// Stage 2 attached the first user-owned resource, `Target`, via `targets`.
/// Stage 3 adds `scans`: every scan records who requested it, independent of
/// (but in practice always aligned with) who currently owns its target — see
/// the delete-behavior comment on `Scan` for why both relations are
/// `Restrict` rather than `Cascade`. Later stages will hang findings, AI
/// analyses and reports off it too.
model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  name               String
  passwordHash       String?
  googleId           String?                  @unique
  emailVerified      Boolean                  @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  verificationTokens EmailVerificationToken[]
  targets            Target[]
  scans              Scan[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Whether a target is currently considered in scope for assessment work.
/// Lowercase values so the Prisma client's JSON representation matches the
/// API's wire format with no translation layer in between.
enum TargetStatus {
  active
  inactive
}

/// An authorized web application registered by a user for future security
/// assessment.
///
/// Stage 2 is registration and management only: nothing in this codebase
/// makes a network request to `url`. Later stages (discovery, the
/// SentinelScan scanner, OWASP ZAP) will read `Target` rows as their starting
/// point but are not implemented yet.
model Target {
  id          String       @id @default(uuid())
  ownerId     String
  name        String
  /// Absolute http(s) URL, normalized by the API (see `lib/url.ts`) before
  /// it ever reaches this column.
  url         String
  description String?
  status      TargetStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scans Scan[]

  // A lookup index for "list my targets", and a uniqueness guarantee that
  // stops one user from registering the same URL twice. Two different users
  // may register the same URL — e.g. a shared staging environment both are
  // separately authorized to test — so this is scoped to (ownerId, url)
  // rather than a bare unique constraint on `url`.
  @@unique([ownerId, url])
  @@index([ownerId])
  @@map("targets")
}

/// The lifecycle state of a `Scan`. See the state-machine comment on `Scan`
/// for which transitions between these are actually legal.
enum ScanStatus {
  queued
  running
  completed
  failed
  cancelled
}

/// One requested (or completed, failed, cancelled) execution of a security
/// assessment against a `Target`.
///
/// Stage 3 is orchestration and persistence only: creating a `Scan` never
/// makes a network request, resolves DNS, crawls, or invokes any scanner.
/// `status` starts at `queued` and stays there until Stage 4's real executor
/// (see `modules/scans/scan-executor.ts`) exists to advance it — nothing in
/// this codebase marks a scan `running`/`completed`/`failed` on its own.
///
/// Delete behavior — deliberately `Restrict` on both relations, not
/// `Cascade`:
/// - `target` (→ Target.id): a `Scan` is the historical record of an
///   assessment that was requested (and possibly ran). Cascading it away
///   whenever its `Target` is deleted would silently destroy that audit
///   trail. A target with any scan history therefore cannot be deleted until
///   an explicit archival/retention story exists; `DELETE /targets/:id`
///   reports a clear `409 TARGET_HAS_SCANS` instead of letting Postgres
///   reject the statement with a raw constraint error.
/// - `requestedBy` (→ User.id): for the same reason — who requested a scan
///   is part of the audit record. There is no account-deletion endpoint
///   anywhere in this codebase yet, so this cannot currently be exercised,
///   but it is set deliberately rather than left to a default: whenever
///   account deletion is built, deleting a user with scan history must fail
///   loudly (and be handled explicitly), not silently erase who requested
///   what. Using `Restrict` here rather than `Cascade` also avoids relying on
///   an unspecified evaluation order between this relation and `target`'s
///   `Restrict` for the same row — both simply block, independently and
///   consistently.
model Scan {
  id            String     @id @default(uuid())
  targetId      String
  requestedById String
  status        ScanStatus @default(queued)
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  target      Target            @relation(fields: [targetId], references: [id], onDelete: Restrict)
  requestedBy User              @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  findings    Finding[]
  /// At most one per scan in Stage 6 — see the uniqueness-strategy comment on
  /// `SecurityAnalysis.scanId` below.
  analysis    SecurityAnalysis?

  @@index([targetId])
  @@index([requestedById])
  @@index([status])
  // Supports the "my scans, newest first" query — the actual shape GET
  // /scans runs — better than a bare index on `createdAt` alone would.
  @@index([requestedById, createdAt])
  @@map("scans")
}

/// SentinelScan's own severity scale. Deliberately not ZAP's "risk" strings
/// (High/Medium/Low/Informational) — this is the vendor-neutral scale every
/// scanner source normalizes into. `critical` exists even though nothing in
/// this codebase currently produces it (ZAP's risk levels top out at High);
/// it is here so a future scanner (or a future ZAP alert tag/rule) that does
/// distinguish a critical tier has somewhere to map to without a schema
/// change.
enum FindingSeverity {
  critical
  high
  medium
  low
  informational
}

/// How confident the scanner is that a finding is a true positive.
/// `unknown` is the documented fallback for a source that doesn't report
/// confidence, or reports something this codebase doesn't recognize — never
/// silently invented as `low` or `medium`, which would misrepresent it.
enum FindingConfidence {
  high
  medium
  low
  unknown
}

// `category` (below, on `Finding`) is deliberately a plain `String`, not a
// Prisma `enum`, even though it is a closed, validated set of values — see
// `FINDING_CATEGORIES` in `modules/findings/finding-category.ts` for that
// set and its wire-format documentation. Prisma enum *values* must be valid
// identifiers (no hyphens), and a value's `@map` only renames its Postgres
// storage label — the JS-facing string Prisma Client actually returns is
// always the identifier itself. There is no way to make a Prisma enum whose
// JS value is a hyphenated slug like `"security-misconfiguration"`, which is
// the wire format this category set intentionally uses (matching typical
// kebab-case REST conventions, and the exact spelling used throughout this
// project's Stage 5 API surface and documentation). Rather than force an
// awkward camelCase-in-JS/hyphenated-at-the-boundary translation layer, or
// silently ship a different wire format than intended, category validation
// lives at the application boundary (Zod, matching the closed set) instead
// of the database layer. `severity` and `confidence` below stay real Prisma
// enums: their value sets need no hyphens, so they get the database-level
// guarantee with no such tradeoff.

/// One normalized vulnerability/security issue identified during a `Scan`.
///
/// A `Finding` represents *one logical vulnerability/rule for one scan* — not
/// a specific occurrence. Where it was found (potentially several places) is
/// `FindingInstance`. This model deliberately does not mirror any scanner's
/// raw schema: `source`/`sourceRuleId` are the only scanner-specific fields,
/// kept purely for traceability back to where a finding came from. See
/// `modules/findings/normalized-finding.ts` for the scanner-neutral shape
/// every adapter (ZAP today, anything else later) must produce, and
/// `modules/findings/zap/` for the ZAP-specific adapter and its severity/
/// confidence/category mapping tables.
///
/// Deduplication: at most one `Finding` per `(scanId, source, sourceRuleId)`
/// — the same rule firing at multiple URLs in one scan is one `Finding` with
/// multiple `FindingInstance` rows, not multiple `Finding` rows. The same
/// rule firing again in a *different* scan (even against the same target) is
/// a separate `Finding`: findings are scoped to the scan that produced them,
/// never deduplicated globally across scans, because each scan is its own
/// historical record of what was true at that point in time. See the
/// README's "Deduplication Strategy" section for the full reasoning,
/// including the fallback used when a source has no stable rule identifier.
///
/// Delete behavior: `scan` is `Restrict`, matching `Scan`'s own relations —
/// findings are historical scan results, and a `Scan` cannot currently be
/// deleted through any endpoint in this codebase at all, so this is a
/// consistent, defensive schema-level choice rather than something
/// exercised today. `instances` cascades: a `FindingInstance` has no
/// independent identity or historical significance apart from the `Finding`
/// it belongs to, unlike `Finding` itself relative to `Scan`.
model Finding {
  id           String            @id @default(uuid())
  scanId       String
  title        String
  description  String
  severity     FindingSeverity
  confidence   FindingConfidence
  /// A closed set of values, validated at the application layer — see the
  /// comment above `FindingSeverity` for why this is a `String`, not an `enum`.
  category     String
  /// Common Weakness Enumeration id (e.g. 79 for CWE-79), when the source provides one.
  cweId        Int?
  /// Web Application Security Consortium id, when the source provides one.
  wascId       Int?
  remediation  String?
  /// A JSON array of reference URLs (strings). Structured just enough for a
  /// future frontend/AI layer to iterate over cleanly, without inventing a
  /// separate table for what is, in practice, always a short flat list.
  references   Json?
  /// Which scanner produced this finding, e.g. `"zap"`. A plain string, not
  /// an enum: a new scanner source must not require a migration to exist —
  /// see this file's "vendor-neutral" principle at the top.
  source       String
  /// The source scanner's own stable rule/plugin identifier (ZAP's
  /// `pluginId`, e.g. `"10020"`), when available. Never just the
  /// human-readable alert name — see the dedup comment above.
  sourceRuleId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  scan            Scan                 @relation(fields: [scanId], references: [id], onDelete: Restrict)
  instances       FindingInstance[]
  /// Stage 6: the AI Security Analyst's per-finding assessment(s). At most
  /// one per `(analysisId, findingId)` pair — see `FindingAssessment`.
  assessments     FindingAssessment[]
  /// Stage 6: correlations where this finding is named as the "A" side.
  correlationsAsA FindingCorrelation[] @relation("FindingCorrelationA")
  /// Stage 6: correlations where this finding is named as the "B" side.
  correlationsAsB FindingCorrelation[] @relation("FindingCorrelationB")

  @@unique([scanId, source, sourceRuleId])
  @@index([scanId])
  @@index([scanId, severity])
  @@map("findings")
}

/// One location where a `Finding`'s vulnerability/rule was actually observed
/// — a specific URL, and where applicable the HTTP method, parameter, attack
/// payload, and a short evidence snippet. Deliberately not a full HTTP
/// request/response capture: `attack`/`evidence`/`parameter` are sanitized
/// (secrets redacted, length capped — see `lib/sanitize-text.ts`) and bounded
/// scanner-output snippets, never raw request/response bodies, cookies,
/// Authorization headers, or other credential material.
model FindingInstance {
  id        String   @id @default(uuid())
  findingId String
  url       String
  method    String?
  parameter String?
  attack    String?
  evidence  String?
  createdAt DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_instances")
}

// ---------------------------------------------------------------------------
// Stage 6: AI Security Analyst.
//
// The AI is not the scanner and never makes network requests, crawls, or
// executes anything against a target — it reasons over already-persisted
// `Finding`/`FindingInstance` rows and produces a structured, validated
// assessment. See `modules/analysis/` for the deterministic preprocessing,
// provider abstraction, prompt, and Zod-validated output contract; nothing
// here stores an AI provider's raw response or API credentials.
// ---------------------------------------------------------------------------

/// Lifecycle state of a `SecurityAnalysis`. Mirrors `ScanStatus`'s shape —
/// `queued` → `running` → (`completed` | `failed`), both of the latter
/// terminal — but is a separate enum because an analysis's lifecycle is
/// conceptually independent of its scan's (a scan is always `completed`
/// before an analysis can even be requested; see `SecurityAnalysis.scanId`).
enum AnalysisStatus {
  queued
  running
  completed
  failed
}

/// The AI's overall risk verdict for the scan as a whole. Same five-level
/// scale as `FindingSeverity`, kept as a distinct enum (not reused) so that a
/// scanner-assigned severity and an AI-assigned risk/priority are never
/// representationally conflated — see the `FindingAssessment.priority` doc
/// comment for why this separation matters.
enum OverallRisk {
  critical
  high
  medium
  low
  informational
}

/// The AI's priority/urgency judgment for one finding (or for remediating
/// it) — deliberately the same five-level scale as `FindingSeverity` but a
/// distinct enum, never reused in place of it. `Finding.severity` is the
/// scanner's own, unmodified verdict; `FindingAssessment.priority` (and
/// `.remediationPriority`) are the AI's separate judgment, which may
/// legitimately differ from the scanner severity when supporting evidence or
/// correlation with other findings justifies it. The AI is never allowed to
/// rewrite `Finding.severity` itself — only to add its own opinion alongside
/// it, with reasoning.
enum AssessmentPriority {
  critical
  high
  medium
  low
  informational
}

/// How likely the AI judges a finding to be a false positive. Deliberately
/// not a boolean and never used to delete or suppress a `Finding` — human
/// review remains authoritative. `unknown` is the honest default when the
/// supplied evidence doesn't support a judgment either way.
enum FalsePositiveLikelihood {
  low
  medium
  high
  unknown
}

/// One AI-generated security analysis of a completed `Scan`'s findings.
///
/// **Uniqueness strategy (Stage 6 decision):** `scanId` is `@unique` — at
/// most one `SecurityAnalysis` ever exists per scan in this stage, in any
/// status. `AnalysisStatus` has no transition back out of `failed` (see that
/// enum's doc comment), so a failed analysis is not retryable in place, and
/// a completed one is never silently overwritten by a rerun — `POST
/// /scans/:scanId/analyze` simply refuses with `409` once any row exists for
/// that scan, regardless of its status. This is a deliberately conservative
/// choice for Stage 6, not an oversight: real multi-version analysis
/// (re-running with a new prompt/model while keeping prior results) is
/// explicitly future work — see the README's "Analysis Re-runs" section —
/// and would be introduced by relaxing this constraint to
/// `@@unique([scanId, promptVersion])` or dropping it in favor of an
/// explicit "current analysis" pointer, not by changing anything else about
/// this model's shape.
///
/// **Delete behavior:** `scan` is `Restrict`, matching every other relation
/// to `Scan` in this schema — an analysis is part of a scan's historical
/// record, and `Scan` deletion isn't possible through any endpoint anyway.
model SecurityAnalysis {
  id                 String         @id @default(uuid())
  scanId             String         @unique
  status             AnalysisStatus @default(queued)
  /// Which AI model produced this analysis (e.g. `"claude-sonnet-5"`), set
  /// only once the analysis completes. Purely for auditability — never used
  /// to branch application logic.
  model              String?
  /// Which version of the security-analysis system prompt produced this
  /// analysis (see `modules/analysis/analysis-prompt.ts`). Set at creation,
  /// before the model is ever called, so it is always present even if the
  /// analysis later fails.
  promptVersion      String
  overallRisk        OverallRisk?
  executiveSummary   String?
  methodologySummary String?
  /// Free text describing this analysis's own limitations (e.g. truncated
  /// findings, low-confidence areas) — the AI's own caveats, not an error.
  limitations        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?
  /// Set only on `failed`; a safe, never-raw-provider-error message — see
  /// `modules/analysis/security-analysis-executor.ts`'s `safeMessage`.
  errorMessage       String?

  scan         Scan                 @relation(fields: [scanId], references: [id], onDelete: Restrict)
  assessments  FindingAssessment[]
  correlations FindingCorrelation[]

  @@index([scanId])
  @@index([status])
  @@map("security_analyses")
}

/// The AI's structured assessment of one `Finding` within one
/// `SecurityAnalysis`. See the `AssessmentPriority` doc comment for why
/// `priority`/`remediationPriority` here are kept strictly separate from
/// `Finding.severity` — the AI never rewrites the scanner's own verdict.
///
/// At most one assessment per `(analysisId, findingId)` — the AI assesses
/// each finding once per analysis run, not multiple times.
///
/// **Delete behavior:** `analysis` cascades (a `FindingAssessment` has no
/// meaning outside the `SecurityAnalysis` it belongs to); `finding` is
/// `Restrict` (consistent with every other relation to `Finding` in this
/// schema — `Finding` deletion isn't possible through any endpoint).
model FindingAssessment {
  id                      String                  @id @default(uuid())
  analysisId              String
  findingId               String
  /// The AI's own priority judgment for this finding — see the
  /// `AssessmentPriority` enum doc comment. Deliberately separate from
  /// `Finding.severity`.
  priority                AssessmentPriority
  riskAssessment          String
  /// The AI's confidence in its *own* assessment (not the scanner's
  /// confidence in the finding itself, which lives unmodified on
  /// `Finding.confidence`). Reuses `FindingConfidence` — same underlying
  /// concept (confidence in a claim), applied by a different party.
  confidence              FindingConfidence
  reasoning               String
  businessImpact          String?
  technicalImpact         String?
  /// How urgently this finding's remediation should be scheduled — may
  /// differ from `priority` itself (e.g. a finding could be high-priority to
  /// understand but lower-urgency to fix given a compensating control).
  remediationPriority     AssessmentPriority
  falsePositiveLikelihood FalsePositiveLikelihood
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  analysis SecurityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  finding  Finding          @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@unique([analysisId, findingId])
  @@index([analysisId])
  @@index([findingId])
  @@map("finding_assessments")
}

/// A relationship the AI identified between two findings within one
/// `SecurityAnalysis` — e.g. two findings sharing a root cause, or one
/// amplifying the risk of another. `relationship` is a closed, controlled
/// list (`modules/analysis/analysis-enums.ts`'s `CORRELATION_RELATIONSHIPS`),
/// validated at the application layer — a plain `String` column for the same
/// reason `Finding.category` is (see that model's doc comment): some
/// relationship values are hyphenated (`"attack-chain"`,
/// `"shared-root-cause"`), which a Prisma enum value cannot represent. The
/// AI is never free to invent an arbitrary relationship label.
///
/// `findingAId`/`findingBId` are canonicalized (lexicographically ordered)
/// before persistence, so the same pair is never stored twice in reversed
/// order — see `modules/analysis/security-analysis-executor.ts`.
///
/// **Delete behavior:** `analysis` cascades (same reasoning as
/// `FindingAssessment`); both finding relations are `Restrict`.
model FindingCorrelation {
  id           String            @id @default(uuid())
  analysisId   String
  findingAId   String
  findingBId   String
  /// One of `CORRELATION_RELATIONSHIPS` — see this model's doc comment.
  relationship String
  /// The AI's confidence in this specific correlation claim. Deliberately
  /// per-correlation, not inherited from either finding's own confidence —
  /// a correlation is its own claim, evaluated on its own evidence.
  confidence   FindingConfidence
  explanation  String
  createdAt    DateTime          @default(now())

  analysis SecurityAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  findingA Finding          @relation("FindingCorrelationA", fields: [findingAId], references: [id], onDelete: Restrict)
  findingB Finding          @relation("FindingCorrelationB", fields: [findingBId], references: [id], onDelete: Restrict)

  @@unique([analysisId, findingAId, findingBId])
  @@index([analysisId])
  @@index([findingAId])
  @@index([findingBId])
  @@map("finding_correlations")
}
